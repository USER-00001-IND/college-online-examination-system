# ==============================================================================
# College Online Examination System — Environment Configuration Template
# Gauhati University FYUGP Academic Context
#
# INSTRUCTIONS:
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the actual '.env' file or production credentials to version control.
# ==============================================================================

# Core Django Settings
# Options: config.settings.development | config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret Key
# Production requires a random cryptographic string (minimum 32 characters).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-cryptographically-secure-random-string-at-least-32-chars

# Hosts and Network
# Comma-separated domain names or IP addresses. Wildcards (*) are forbidden in production.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# MySQL 8.x Database Configuration
# Production requires explicit MySQL credentials with InnoDB engine and utf8mb4 charset.
DB_NAME=college_exam_db
DB_USER=college_app
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Cross-Origin Resource Sharing (CORS) & CSRF
# Comma-separated list of origins authorized to make cross-origin API requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# HTTPS and SSL Configuration (Production defaults to True)
SECURE_SSL_REDIRECT=True

# Reverse Proxy SSL Header Trust Boundary (Finding B)
# CRITICAL SECURITY CONTROL:
# Defaults to False (SECURE_PROXY_SSL_HEADER = None).
# Set to True ONLY if:
# 1. Nginx terminates TLS and unconditionally overwrites 'X-Forwarded-Proto $scheme;' (never forwards client input).
# 2. Direct client access to Django/Gunicorn is mechanically blocked (via Unix domain socket e.g. /run/gunicorn.sock mode 0660 or firewall).
# If clients can access Django directly, enabling this allows attackers to spoof HTTPS over plain HTTP.
TRUST_PROXY_SSL_HEADER=False

# Reverse Proxy Client IP Trust Boundary (Finding D)
# Independent of TRUST_PROXY_SSL_HEADER.
# Defaults to False (uses validated REMOTE_ADDR).
# Set to True ONLY if Nginx is configured to unconditionally overwrite X-Forwarded-For with $remote_addr.
TRUST_PROXY_CLIENT_IP=False

# Authentication Throttling & Rate Limiting (Finding C)
AUTH_THROTTLE_IP_LIMIT=15
AUTH_THROTTLE_IP_WINDOW=300
AUTH_THROTTLE_TARGET_LIMIT=5
AUTH_THROTTLE_TARGET_WINDOW=300

# Cache Backend (Optional distributed cache for concurrent production workers)
# e.g., REDIS_URL=redis://127.0.0.1:6379/1
# REDIS_URL=

# Reverse Proxy & Ingress Timestamping (Option B Bounded-Processing Consistency)
# Comma-separated list of trusted upstream reverse proxy IPs (Nginx)
TRUSTED_PROXIES=127.0.0.1,10.0.0.1

# ==============================================================================
# Institutional Policy Baseline Configuration Gates
# (Gated until formal institutional confirmation in Chunks 05 / 08)
# ==============================================================================
# EXAM_PIN_DELIVERY_METHOD=UNCONFIGURED
# EXAM_EVIDENCE_KEY_RETENTION_PERIOD=UNCONFIGURED
# INSTITUTIONAL_CONFIG_APPROVED=False
